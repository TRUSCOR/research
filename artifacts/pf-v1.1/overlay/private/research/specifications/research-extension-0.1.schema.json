{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:truscor:sova:private-research-extension:0.1.0",
  "title": "Private SOVA research extension 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "semanticReproduction",
    "evidenceFidelity",
    "executorConformance"
  ],
  "properties": {
    "schemaVersion": {"const": "0.1.0"},
    "semanticReproduction": {"$ref": "#/$defs/semanticReproduction"},
    "evidenceFidelity": {"$ref": "#/$defs/evidenceFidelity"},
    "executorConformance": {"$ref": "#/$defs/executorConformance"},
    "migrationHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "method"],
        "properties": {
          "from": {"type": "string", "minLength": 1},
          "to": {"type": "string", "minLength": 1},
          "method": {"type": "string", "minLength": 1}
        }
      }
    },
    "extensions": {"type": "object"}
  },
  "$defs": {
    "semanticReproduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicates", "sourceContext", "contextRules", "judge"],
      "properties": {
        "predicates": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/predicate"}
        },
        "sourceContext": {"type": "object"},
        "contextRules": {
          "type": "array",
          "items": {"$ref": "#/$defs/contextRule"}
        },
        "judge": {"$ref": "#/$defs/judge"},
        "adjudication": {"$ref": "#/$defs/adjudication"}
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "eventKind", "operator"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "eventKind": {"type": "string", "minLength": 1},
        "operator": {
          "enum": [
            "exists",
            "absent",
            "equals",
            "contains",
            "count-at-least",
            "ordered-before"
          ]
        },
        "path": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "expected": true,
        "minimum": {"type": "integer", "minimum": 1},
        "otherKind": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"}
      }
    },
    "contextRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mode"],
      "properties": {
        "path": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "mode": {"enum": ["exact", "one-of", "tolerance", "record", "ignore"]},
        "allowed": {"type": "array"},
        "tolerance": {"type": "number", "minimum": 0},
        "required": {"type": "boolean"}
      }
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "kind"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "calibration": true,
        "uncertainty": true,
        "limitations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "records"],
      "properties": {
        "status": {
          "enum": ["not-requested", "pending", "resolved", "unresolved"]
        },
        "records": {
          "type": "array",
          "items": {"$ref": "#/$defs/adjudicationRecord"}
        },
        "resolution": {"$ref": "#/$defs/adjudicationResolution"},
        "limitations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "adjudicationRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "adjudicatorId",
        "kind",
        "label",
        "blinded",
        "independentOfImplementation"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "adjudicatorId": {"type": "string", "minLength": 1},
        "kind": {"enum": ["human", "model", "rule"]},
        "label": {
          "enum": [
            "exact",
            "equivalent",
            "divergent",
            "inconclusive",
            "unsafe",
            "incompatible",
            "evidence-invalid"
          ]
        },
        "blinded": {"type": "boolean"},
        "independentOfImplementation": {"type": "boolean"},
        "confidenceBasisPoints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "rationaleDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "createdAt": {"type": "string", "minLength": 1}
      }
    },
    "adjudicationResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "method", "recordIds"],
      "properties": {
        "label": {
          "enum": [
            "exact",
            "equivalent",
            "divergent",
            "inconclusive",
            "unsafe",
            "incompatible",
            "evidence-invalid"
          ]
        },
        "method": {"type": "string", "minLength": 1},
        "recordIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidenceFidelity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claims"],
      "properties": {
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/fidelityClaim"}
        }
      }
    },
    "fidelityClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requirements"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidenceRequirement"}
        }
      }
    },
    "evidenceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "eventKind"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "eventKind": {"type": "string", "minLength": 1},
        "minimum": {"type": "integer", "minimum": 1},
        "requireFullContent": {"type": "boolean"},
        "allowRedacted": {"type": "boolean"},
        "mandatory": {"type": "boolean"},
        "parentKind": {"type": "string", "minLength": 1}
      }
    },
    "executorConformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contracts"],
      "properties": {
        "contracts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/executorContract"}
        }
      }
    },
    "executorContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "action",
        "sideEffect",
        "allowedTerminalStatuses",
        "requiredEvidenceRoles",
        "observations",
        "trustedObserverIds"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "sideEffect": {"enum": ["read", "mutate", "destructive"]},
        "allowedTerminalStatuses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "succeeded",
              "failed",
              "timeout",
              "cancelled",
              "denied",
              "unsupported",
              "partial"
            ]
          }
        },
        "requiredEvidenceRoles": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "observations": {
          "type": "array",
          "items": {"$ref": "#/$defs/observation"}
        },
        "trustedObserverIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "expected"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "path": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "expected": true
      }
    }
  }
}
